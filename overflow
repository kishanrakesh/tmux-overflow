#!/usr/bin/env bash
# overflow — show a tmux pane's scrollback as read-only columns to its left.
# Prefix + O (or `overflow` in a pane) adds a column on the far left, up to three; the press after
# the last one that fits closes them all. Each column shows the screenful above the
# next, so text reads left -> middle -> right. Columns follow the live pane in copy mode and
# close when it closes. The plugin also forwards wheel scrolling on columns to the live pane.
# Output must enter tmux's scrollback. Claude Code needs its classic display ("tui": "default");
# its fullscreen display does not populate tmux's scrollback, so the columns stay empty.
#
#   overflow [PANE]             add a column for PANE, or close them all (default: the current pane)
#   overflow --column PANE N    internal: draw the Nth screenful above PANE until PANE closes
set -uo pipefail

MIN_WIDTH=60   # narrower columns cut Claude Code's lines into unreadable strips
MAX_PANES=4    # the live pane plus up to three columns

column() {
  local live=$1 n=$2 last="unset" shot id h s hist w ww="" off start end row i quiet=99
  local -a rows
  printf '\033[?25l\033[?7l'   # hide the cursor; cut long lines instead of wrapping them
  # Exits once the live pane is gone. tmux 3.4 doesn't fail for a vanished pane id, it prints empty
  # fields, so the returned id is the test.
  while IFS=: read -r id h s hist w < <(tmux display -p -t "$live" '#{pane_id}:#{pane_height}:#{scroll_position}:#{history_size}:#{window_width}' 2>/dev/null) \
        && [[ $id == "$live" ]]; do
    s=${s:-0}                  # empty unless the live pane is scrolled (copy mode)
    # The nearest column also watches the window width: after a resize, refit the columns.
    if (( n == 1 )) && [[ $w != "$ww" ]]; then
      [[ -n $ww ]] && fit "$live" "$w"
      ww=$w
    fi
    off=$(( (n - 1) * h + s )) # history lines between the live pane's top and this column's bottom
    shot=""
    if (( off < hist )); then
      start=$(( -(off + h) )); end=$(( -off - 1 ))
      (( start < -hist )) && start=$(( -hist ))
      shot=$(tmux capture-pane -p -e -t "$live" -S "$start" -E "$end" 2>/dev/null) || exit 0
    fi
    if [[ $shot != "$last" ]]; then
      last=$shot
      rows=()
      [[ -n $shot ]] && mapfile -t rows <<< "$shot"
      # Bottom-aligned, so this column's last line runs straight into the next column's first.
      row=$(( h - ${#rows[@]} ))
      for (( i = 1; i <= row; i++ )); do printf '\033[%d;1H\033[K' "$i"; done
      for (( i = 0; i < ${#rows[@]}; i++ )); do
        printf '\033[%d;1H%s\033[0m\033[K' "$(( row + i + 1 ))" "${rows[i]}"
      done
      quiet=0
    else
      (( quiet++ ))
    fi
    # Fast while the text moves (scrolling or new output), slow once it settles: ~6 ms per check,
    # so 20 checks a second for a moment, then 2, keeps an idle column under 1% of a core.
    if (( quiet < 20 )); then sleep 0.05; else sleep 0.5; fi
  done
}

fit() {
  # After a window resize: close the columns that no longer fit, then share the width evenly.
  local live=$1 w=$2 keep p
  keep=$(( (w + 1) / (MIN_WIDTH + 1) - 1 ))   # columns that fit beside the live pane
  (( keep > MAX_PANES - 1 )) && keep=$(( MAX_PANES - 1 ))
  for p in $(tmux list-panes -t "$live" -F '#{pane_id} #{@overflow_of} #{@overflow_n}' |
             awk -v l="$live" -v k="$keep" '$2 == l && ($3 == "" ? 9 : $3) > k {print $1}'); do
    tmux kill-pane -t "$p"
  done
  tmux select-layout -t "$live" even-horizontal 2>/dev/null
}

toggle() {
  local live=$1 owner mine count width panes left new self
  live=$(tmux display -p -t "$live" '#{pane_id}' 2>/dev/null)
  [[ $live == %* ]] || { echo "overflow: no such pane" >&2; exit 1; }
  # Pressed inside a column: act on the live pane it belongs to.
  owner=$(tmux display -p -t "$live" '#{@overflow_of}')
  [[ $owner == %* ]] && live=$owner
  # The columns this script opened for that pane carry @overflow_of=<its id>; nothing else is touched.
  # Farthest first. A column without a number (opened by an older version) counts as the farthest.
  mine=$(tmux list-panes -t "$live" -F '#{pane_id} #{@overflow_of} #{@overflow_n}' |
         awk -v p="$live" '$2 == p {print ($3 == "" ? 9 : $3), $1}' | sort -rn | awk '{print $2}')
  count=0
  [[ -n $mine ]] && count=$(wc -l <<< "$mine")
  read -r width panes < <(tmux display -p -t "$live" '#{window_width} #{window_panes}')
  if (( panes != count + 1 )); then
    tmux display-message -t "$live" "overflow: needs a window with just this one pane"
    return 0
  fi
  # Each press adds one column on the far left, up to MAX_PANES panes in all; the press after the
  # last column that fits closes them all.
  if (( count + 1 >= MAX_PANES || (width + 1) / (MIN_WIDTH + 1) < count + 2 )); then
    for left in $mine; do tmux kill-pane -t "$left"; done
    if (( count == 0 )); then
      tmux display-message -t "$live" "overflow: this window is $width columns wide; two columns need $(( 2 * MIN_WIDTH + 1 ))+ (maximise the window or shrink the font)"
    fi
    return 0
  fi
  left=$(head -1 <<< "$mine"); left=${left:-$live}
  self=$(readlink -f "$0")
  new=$(tmux split-window -h -b -d -t "$left" -P -F '#{pane_id}' "exec '$self' --column '$live' $(( count + 1 ))") || return 1
  tmux set -p -t "$new" @overflow_of "$live"
  tmux set -p -t "$new" @overflow_n "$(( count + 1 ))"
  tmux select-layout -t "$live" even-horizontal
}

if [[ ${1:-} == --column ]]; then
  column "$2" "$3"
else
  [[ -n ${1:-}${TMUX_PANE:-} ]] || { echo "overflow: run it inside tmux, or name a pane" >&2; exit 1; }
  toggle "${1:-$TMUX_PANE}"
fi
